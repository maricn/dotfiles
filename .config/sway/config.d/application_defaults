# Custom windowing rules
for_window [class="Yad" instance="yad"] floating enable
for_window [app_id="yad"] floating enable
for_window [app_id="blueman-manager"] floating enable, resize set width 40 ppt height 30 ppt
for_window [app_id="pavucontrol" ] floating enable, resize set width 40 ppt height 80 ppt
for_window [app_id="org.keepassxc.KeePassXC" ] floating enable, resize set width 40 ppt height 30 ppt workspace scratchpad
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [window_role="About"] floating enable
for_window [title="File Operation Progress"] floating enable, border pixel 1, sticky enable, resize set width 40 ppt height 30 ppt
for_window [app_id="floating_shell_portrait"] floating enable, border pixel 1, sticky enable, resize set width 30 ppt height 40 ppt
for_window [title="Picture in picture"] floating enable, sticky enable
for_window [title="waybar_htop"] floating enable, resize set width 70 ppt height 70 ppt
for_window [title="waybar_nmtui"] floating enable
for_window [title="Save File"] floating enable
for_window [app_id="firefox" title="Firefox — Sharing Indicator"] kill
for_window [app_id="librewolf" title="Librewolf — Sharing Indicator"] kill
for_window [app_id="nwg-displays"] floating enable
for_window [app_id="Waydroid"] floating enable, resize set width 40 ppt height 60 ppt
for_window [app_id="com.github.wwmm.easyeffects"] floating enable, resize set width 40 ppt height 80 ppt workspace scratchpad
for_window [app_id="thunar"] floating enable
for_window [class="copyq"] floating enable, border pixel 6
for_window [instance="copyq"] floating enable, border pixel 6
for_window [app_id="copyq"] floating enable, border pixel 6
for_window [app_id="nm-connection-editor"] floating enable, border pixel 6

# Assign apps to workspaces (scratchpad assignment in the section above)
assign [app_id="librewolf"] 1
assign [app_id="thunderbird"] 2
assign [class="Signal"] 2
assign [class="teams-for-linux"] 2

# Inhibit idle when in fullscreen (watching videos)
for_window [app_id="firefox"] inhibit_idle fullscreen
for_window [app_id="librewolf"] inhibit_idle fullscreen 
for_window [app_id="floorp"] inhibit_idle fullscreen
for_window [app_id="Chromium"] inhibit_idle fullscreen
for_window [app_id="mpv"] inhibit_idle fullscreen
for_window [class="vlc"] inhibit_idle fullscreen

