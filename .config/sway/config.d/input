### Input configuration
#
# Read `man 5 sway-input` for more information about this section.

# Hide mouse cursor after 10 seconds
seat * hide_cursor 10000
seat * xcursor_theme default 50
# Set cursor theme
# see ./config.d/theme and ./scripts/import-gsettings

# Natural scroll always enabled
input * {
    natural_scroll enabled
}

# Touchpad configuration
input type:touchpad {
    # Disable While Typing = on
    dwt enabled
    tap enabled
    drag_lock disabled
}
focus_follows_mouse no

# Swipe 4 fingers
bindgesture swipe:4:right workspace prev
bindgesture swipe:4:left workspace next
bindgesture pinch:4:inward fullscreen

# Keyboard setup
input type:keyboard {
    repeat_delay 250
    repeat_rate 33
    # EN, RS_lat, RS_cyr, DE and no xkb based cadets
    # (use interception tools like caps2esc for cadets)
    #xkb_file ~/.dotfiles/xkb/xkb_arch.xkb
    xkb_layout us,de,rs,hr
    # intl uses deadkeys
    # xkb_variant intl
    xkb_options grp:alt_shift_toggle,grp:ctrls_toggle,grp_led:caps
    # Enable numlock by default
    xkb_numlock enabled
}

# Trackball scroll method
input "1133:50184:Logitech_USB_Trackball" {
    scroll_method on_button_down
}

