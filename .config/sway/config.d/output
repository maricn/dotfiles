### Output configuration
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs
#
# You can also bind workspaces 1,2,3 to specific outputs
#
# workspace 1 output eDP-2
# workspace 2 output HDMI-A-1
# workspace 3 output DP-1
workspace 1 output eDP-1
#
# Wacom Tablet - Example
#   input "1386:884:Wacom_Intuos_S_Pad" map_to_output HDMI-A-1
#   input "1386:884:Wacom_Intuos_S_Pen" map_to_output HDMI-A-1

# Use nwg-displays output
# include ~/.config/sway/outputs
# include ~/.config/sway/workspaces

# Use way-displays
# see config.d/autostart_applications
# exec way-displays > /tmp/way-displays.${XDG_VTNR}.${USER}.log 2>&1

workspace 1 output HDMI-A-1 DP-1 DP-2 eDP-1
workspace 2 output HDMI-A-1 DP-1 DP-2 eDP-1
workspace 3 output HDMI-A-1 DP-1 DP-2 eDP-1
workspace 4 output HDMI-A-1 DP-1 DP-2 eDP-1
workspace 5 output HDMI-A-1 DP-1 DP-2 eDP-1
workspace 6 output eDP-1 DP-1 DP-2 HDMI-A-1
workspace 7 output eDP-1 DP-1 DP-2 HDMI-A-1
workspace 8 output eDP-1 DP-1 DP-2 HDMI-A-1
workspace 9 output eDP-1 DP-1 DP-2 HDMI-A-1
workspace 10 output eDP-1 DP-1 DP-2 HDMI-A-1

bindsym $mod+Mod1+h move workspace to output left
bindsym $mod+Mod1+j move workspace to output down
bindsym $mod+Mod1+k move workspace to output up
bindsym $mod+Mod1+l move workspace to output right

# vim: set ft=swayconfig:
