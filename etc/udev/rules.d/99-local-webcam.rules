SUBSYSTEM=="video4linux", SUBSYSTEMS=="usb", ATTRS{idVendor}=="174f", ATTRS{idProduct}=="11b3", PROGRAM="/usr/bin/v4l2-ctl --device /dev/video0 --set-ctrl=brightness=160 --set-ctrl=contrast=36 --set-ctrl=saturation=65 --set-ctrl=hue=0 --set-ctrl=white_balance_automatic=1 --set-ctrl=gamma=150 --set-ctrl=power_line_frequency=1 --set-ctrl=sharpness=4 --set-ctrl=backlight_compensation=0 --set-ctrl=auto_exposure=0 --set-ctrl=exposure_dynamic_framerate=1 --set-ctrl=exposure_time_absolute=550 --set-fmt-video=width=2560,height=1440,pixelformat=MJPG && echo 'Updated v4l2 /dev/video0 defaults!' || echo 'Failed updating v4l2 /dev/video0 defaults!' >&2 2>&1"
